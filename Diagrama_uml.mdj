,"headQualifiersCompartment":{"$ref":"AAAAAAGdTqwBLFMEZH0="}}]},{"_type":"UMLActor","_id":"AAAAAAGclVmhmISFVWY=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Usuario","ownedElements":[{"_type":"UMLAssociation","_id":"AAAAAAGclVr2qoVmpGc=","_parent":{"$ref":"AAAAAAGclVmhmISFVWY="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclVr2qoVna1o=","_parent":{"$ref":"AAAAAAGclVr2qoVmpGc="},"reference":{"$ref":"AAAAAAGclVmhmISFVWY="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclVr2qoVoMrg=","_parent":{"$ref":"AAAAAAGclVr2qoVmpGc="},"reference":{"$ref":"AAAAAAGclVqh94UyQ/Q="}}},{"_type":"UMLAssociation","_id":"AAAAAAGclWJql7mWklA=","_parent":{"$ref":"AAAAAAGclVmhmISFVWY="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclWJql7mXVbc=","_parent":{"$ref":"AAAAAAGclWJql7mWklA="},"reference":{"$ref":"AAAAAAGclVmhmISFVWY="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclWJql7mYw1Q=","_parent":{"$ref":"AAAAAAGclWJql7mWklA="},"reference":{"$ref":"AAAAAAGclVvXGY9SyJg="}}},{"_type":"UMLAssociation","_id":"AAAAAAGclWKG1b4CH7A=","_parent":{"$ref":"AAAAAAGclVmhmISFVWY="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclWKG1b4DZT0=","_parent":{"$ref":"AAAAAAGclWKG1b4CH7A="},"reference":{"$ref":"AAAAAAGclVmhmISFVWY="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclWKG1b4EQkM=","_parent":{"$ref":"AAAAAAGclWKG1b4CH7A="},"reference":{"$ref":"AAAAAAGclVv0io/URwQ="}}}]},{"_type":"UMLActor","_id":"AAAAAAGclVnrE4SvL1A=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Vendedor","ownedElements":[{"_type":"UMLGeneralization","_id":"AAAAAAGclVtkGormCUs=","_parent":{"$ref":"AAAAAAGclVnrE4SvL1A="},"source":{"$ref":"AAAAAAGclVnrE4SvL1A="},"target":{"$ref":"AAAAAAGclVoJ/oTZAl4="}},{"_type":"UMLAssociation","_id":"AAAAAAGdTqqHL7jiRVQ=","_parent":{"$ref":"AAAAAAGclVnrE4SvL1A="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGdTqqHL7jjbUY=","_parent":{"$ref":"AAAAAAGdTqqHL7jiRVQ="},"reference":{"$ref":"AAAAAAGclVnrE4SvL1A="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGdTqqHL7jkry8=","_parent":{"$ref":"AAAAAAGdTqqHL7jiRVQ="},"reference":{"$ref":"AAAAAAGdTqoqMbIj1DU="}}}]},{"_type":"UMLActor","_id":"AAAAAAGclVoJ/oTZAl4=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Comprador","ownedElements":[{"_type":"UMLGeneralization","_id":"AAAAAAGclVuHa43gLP8=","_parent":{"$ref":"AAAAAAGclVoJ/oTZAl4="},"source":{"$ref":"AAAAAAGclVoJ/oTZAl4="},"target":{"$ref":"AAAAAAGclVmhmISFVWY="}},{"_type":"UMLAssociation","_id":"AAAAAAGclV+kPawm4xo=","_parent":{"$ref":"AAAAAAGclVoJ/oTZAl4="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclV+kPawn/6E=","_parent":{"$ref":"AAAAAAGclV+kPawm4xo="},"reference":{"$ref":"AAAAAAGclVoJ/oTZAl4="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclV+kPawo0dI=","_parent":{"$ref":"AAAAAAGclV+kPawm4xo="},"reference":{"$ref":"AAAAAAGclVu2447QrMo="}}},{"_type":"UMLAssociation","_id":"AAAAAAGdTqrOFMAEx/Q=","_parent":{"$ref":"AAAAAAGclVoJ/oTZAl4="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGdTqrOFMAFbxQ=","_parent":{"$ref":"AAAAAAGdTqrOFMAEx/Q="},"reference":{"$ref":"AAAAAAGclVoJ/oTZAl4="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGdTqrOFMAGPP0=","_parent":{"$ref":"AAAAAAGdTqrOFMAEx/Q="},"reference":{"$ref":"AAAAAAGdTqqXmLo2igE="}}},{"_type":"UMLAssociation","_id":"AAAAAAGdTqwBKlL1kw8=","_parent":{"$ref":"AAAAAAGclVoJ/oTZAl4="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGdTqwBK1L288E=","_parent":{"$ref":"AAAAAAGdTqwBKlL1kw8="},"reference":{"$ref":"AAAAAAGclVoJ/oTZAl4="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGdTqwBK1L344Y=","_parent":{"$ref":"AAAAAAGdTqwBKlL1kw8="},"reference":{"$ref":"AAAAAAGdTqrn0cSnO2w="}}}]},{"_type":"UMLUseCase","_id":"AAAAAAGclVp/nIUEhiU=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Iniciar Sesión","ownedElements":[{"_type":"UMLAssociation","_id":"AAAAAAGclVsOo4ZAp9U=","_parent":{"$ref":"AAAAAAGclVp/nIUEhiU="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclVsOo4ZBFmA=","_parent":{"$ref":"AAAAAAGclVsOo4ZAp9U="},"reference":{"$ref":"AAAAAAGclVp/nIUEhiU="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclVsOo4ZCyfQ=","_parent":{"$ref":"AAAAAAGclVsOo4ZAp9U="},"reference":{"$ref":"AAAAAAGclVp/nIUEhiU="}}},{"_type":"UMLAssociation","_id":"AAAAAAGclVs3IIeFHIM=","_parent":{"$ref":"AAAAAAGclVp/nIUEhiU="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclVs3IIeGAds=","_parent":{"$ref":"AAAAAAGclVs3IIeFHIM="},"reference":{"$ref":"AAAAAAGclVp/nIUEhiU="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclVs3IIeH/gM=","_parent":{"$ref":"AAAAAAGclVs3IIeFHIM="},"reference":{"$ref":"AAAAAAGclVmhmISFVWY="}}}],"documentation":"# Flujo de eventos: Iniciar Sesión\n\n1. El usuario indica su nombre y contraseña.\n2. El sistema busca al usuario con esa contraseña y le asigna el rol que le corresponda (comprador o vendedor).\n\n# Flujo de eventos alternativo\n\n* Si no existe usuario con ese nombre y esa contraseña, no se le permite registrarse y el sistema muestra un mensaje de error.\n"},{"_type":"UMLUseCase","_id":"AAAAAAGclVqh94UyQ/Q=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Registrarse","documentation":"# Flujo de eventos: Registrarse\n\n1. El usuario indica su nombre, contraseña y tipo de cuenta (comprador o vendedor).\n2. El sistema guarda el nombre, la contraseña y el tipo de la cuenta. \n# Flujo de eventos alternativo\n\n* Si el sistema ya tiene almacenado a ese ususario con ese nombre y contraseña, el sistema no guarda nada. Se muestar un mensaje de error."},{"_type":"UMLUseCase","_id":"AAAAAAGclVu2447QrMo=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Aceptar Oferta","ownedElements":[{"_type":"UMLExtend","_id":"AAAAAAGcntIpnvzwrc4=","_parent":{"$ref":"AAAAAAGclVu2447QrMo="},"source":{"$ref":"AAAAAAGclVu2447QrMo="},"target":{"$ref":"AAAAAAGclVvXGY9SyJg="}}],"documentation":"# Flujo de eventos: Aceptar Oferta\n\n1. El comprador inserta la clave de una Oferta y el precio que está dispuesto a apagr.\n2. El sistema guarda la propuesta.\n\n\n# Flujo de eventos alternativo\n\n* No se introduce un valor monetario válido. No se guarda la propuesta de oferta. \n\n* El saldo del comprador es negativo o igual a 0. No se guarda la propuesta de oferta.\n"},{"_type":"UMLUseCase","_id":"AAAAAAGclVvXGY9SyJg=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Ver Oferta","ownedElements":[{"_type":"UMLExtend","_id":"AAAAAAGcnsRs/MTFU/c=","_parent":{"$ref":"AAAAAAGclVvXGY9SyJg="},"source":{"$ref":"AAAAAAGclVvXGY9SyJg="},"target":{"$ref":"AAAAAAGclVv0io/URwQ="}}],"documentation":"# Flujo de eventos: Ver Oferta\n1. El usuariro inserta una clave de una Oferta.\n2. El sistema muestra toda la información asociada con la clave (título, descripción, estado, precio, fecha de publicación y archeivo(foto)).\n3. Si el usuario quiere ofrecer algún precio por la oferta, extends Aceptar Oferta.\n\n#Flujo alternativo\n* Si algún atributo no tiene ningún valor, se mostrará vacío."},{"_type":"UMLUseCase","_id":"AAAAAAGclVv0io/URwQ=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Consultar Ofertas","documentation":"# Flujo de eventos: Consultar ofertas\n\n1. El ususario inserta un texto.\n2. El sistema muestra las ofertas activas (título, descripción, fecha de publicación) que contengan el texto insertado en el título.\n3. Si el ususario es comprador y quiere ver los detalles de la oferta extends Ver Oferta.\n\n# Flujo de eventos alternativo\n\n* No existen ofertas activas con el texto en su título. Se muestra un menaje que describa la situación.\n"},{"_type":"UMLUseCase","_id":"AAAAAAGclVxL0ZDllLk=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Ver ofertas Aceptadas","ownedElements":[{"_type":"UMLAssociation","_id":"AAAAAAGclV0JwJl/NM0=","_parent":{"$ref":"AAAAAAGclVxL0ZDllLk="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclV0JwJmAMyE=","_parent":{"$ref":"AAAAAAGclV0JwJl/NM0="},"reference":{"$ref":"AAAAAAGclVxL0ZDllLk="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclV0JwJmBdkk=","_parent":{"$ref":"AAAAAAGclV0JwJl/NM0="},"reference":{"$ref":"AAAAAAGclVnrE4SvL1A="}}}],"documentation":"#Flujo de eventos: Ver Ofertas Aceotadas\n1. El vendedor inserta un texto.\n2. El sistema muestra las Sales asociadas al vendedor (títuo y precios ofrecidos) que contengan el texto en el título.\n"},{"_type":"UMLUseCase","_id":"AAAAAAGclVyJzpFnzVY=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Crear oferta","ownedElements":[{"_type":"UMLAssociation","_id":"AAAAAAGclVzblJUKZFo=","_parent":{"$ref":"AAAAAAGclVyJzpFnzVY="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclVzblJULCW8=","_parent":{"$ref":"AAAAAAGclVzblJUKZFo="},"reference":{"$ref":"AAAAAAGclVyJzpFnzVY="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclVzblJUMnlQ=","_parent":{"$ref":"AAAAAAGclVzblJUKZFo="},"reference":{"$ref":"AAAAAAGclVnrE4SvL1A="}}}],"documentation":"# Flujo de eventos: Crear Oferta\n1. Vendedor inserta título, descripción, estado y precio.\n2. Vendedor selecciona una fecha de publicación.\n3. Vendedor selecciona un File.\n4. El sistema crea una Sale con la indormación insertada y asigna la Sale al Seller.\n\n# Flujo alternativo\n1. Algún campo está vacío. El sistema informa al vendedor.\n2. EL precio no es un número válido. El sistema informa al vendedor.\n3. La fecha de publicación es anterior a la fecha actual. El sistema informa al vendedor.\n4. La oferta Sale ya existe para este vendedor (mismo título). El sistema informa al vendedor.\n"},{"_type":"UMLUseCase","_id":"AAAAAAGdTqoqMbIj1DU=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Aceptar propuesta","documentation":"# Flujo de eventos: Aceptar Propuesta\n1. El vendedor inserta la clave de una ProposedSale propuesta.\n2. El sistema procede a retirar del saldo del Comprador que ha hecho la propuesta la cantidadOferecida.\n3. El sistema guarda la Oferta como acabada.\n4. El sistema guarda en la ProposedSale la fecha de la compra.\n5. El sistema ingresa el importe de la compra al Vendedor.\n\n#Flujo alternativo\n* Si la Sale asociada a la ProposedSale tiene estado \"Saled\", el sistema no hará nada.\n\n* Si el comprador tiene saldo menor o igual que 0, el sistema solo mostrará un mensaje de error en pantalla."},{"_type":"UMLUseCase","_id":"AAAAAAGdTqqXmLo2igE=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Ingresar Fondos","documentation":"# Flujo de eventos: Ingresar Fondos\n\n1. El comprador inserta la cantidad de fondos a ingresar.\n2. El sistema crea una Transacción de tipo ingreso con la cantidad insertada."},{"_type":"UMLUseCase","_id":"AAAAAAGdTqrn0cSnO2w=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Valorar compra","documentation":"# Flujo de eventos: Valorar Compra\n\n1. Comrpador inserta la clave de una ProposedSale que haya sido aceptada.\n2. Comprador inserta un número entre el 1 y 10 (valoración) y un breve texto explicando la razón de la valoración."}]}]}]}