						{
							"_type": "UMLUseCase",
							"_id": "AAAAAAGclVp/nIUEhiU=",
							"_parent": {
								"$ref": "AAAAAAFF+qBWK6M3Z8Y="
							},
							"name": "Iniciar Sesión",
							"ownedElements": [
								{
									"_type": "UMLAssociation",
									"_id": "AAAAAAGclVsOo4ZAp9U=",
									"_parent": {
										"$ref": "AAAAAAGclVp/nIUEhiU="
									},
									"end1": {
										"_type": "UMLAssociationEnd",
										"_id": "AAAAAAGclVsOo4ZBFmA=",
										"_parent": {
											"$ref": "AAAAAAGclVsOo4ZAp9U="
										},
										"reference": {
