AAGclVoJ/oTZAl4="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGeCOUcnQwratU=","_parent":{"$ref":"AAAAAAGeCOUcnQwqaPk="},"reference":{"$ref":"AAAAAAGclVoJ/oTZAl4="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGeCOUcnQwsglg=","_parent":{"$ref":"AAAAAAGeCOUcnQwqaPk="},"reference":{"$ref":"AAAAAAGd3qWCoYheBFY="}}},{"_type":"UMLAssociation","_id":"AAAAAAGeCOW0+yq01EU=","_parent":{"$ref":"AAAAAAGclVoJ/oTZAl4="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGeCOW0+yq1lhI=","_parent":{"$ref":"AAAAAAGeCOW0+yq01EU="},"reference":{"$ref":"AAAAAAGclVoJ/oTZAl4="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGeCOW0+yq2rpg=","_parent":{"$ref":"AAAAAAGeCOW0+yq01EU="},"reference":{"$ref":"AAAAAAGeCOV7GRzOfvU="}}}]},{"_type":"UMLUseCase","_id":"AAAAAAGclVp/nIUEhiU=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Iniciar Sesión","ownedElements":[{"_type":"UMLAssociation","_id":"AAAAAAGclVsOo4ZAp9U=","_parent":{"$ref":"AAAAAAGclVp/nIUEhiU="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclVsOo4ZBFmA=","_parent":{"$ref":"AAAAAAGclVsOo4ZAp9U="},"reference":{"$ref":"AAAAAAGclVp/nIUEhiU="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclVsOo4ZCyfQ=","_parent":{"$ref":"AAAAAAGclVsOo4ZAp9U="},"reference":{"$ref":"AAAAAAGclVp/nIUEhiU="}}},{"_type":"UMLAssociation","_id":"AAAAAAGclVs3IIeFHIM=","_parent":{"$ref":"AAAAAAGclVp/nIUEhiU="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclVs3IIeGAds=","_parent":{"$ref":"AAAAAAGclVs3IIeFHIM="},"reference":{"$ref":"AAAAAAGclVp/nIUEhiU="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclVs3IIeH/gM=","_parent":{"$ref":"AAAAAAGclVs3IIeFHIM="},"reference":{"$ref":"AAAAAAGclVmhmISFVWY="}}}],"documentation":"# Flujo de eventos: Iniciar Sesión\n\n1. El usuario indica su nombre y contraseña.\n2. El sistema busca al usuario con esa contraseña y le asigna el rol que le corresponda (comprador o vendedor).\n\n# Flujo de eventos alternativo\n\n* Si no existe usuario con ese nombre y esa contraseña, no se le permite registrarse y el sistema muestra un mensaje de error.\n"},{"_type":"UMLUseCase","_id":"AAAAAAGclVqh94UyQ/Q=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Registrarse","documentation":"# Flujo de eventos: Registrarse\n\n1. El usuario indica su nombre, contraseña y tipo de cuenta (comprador o vendedor).\n2. El sistema guarda el nombre, la contraseña y el tipo de la cuenta. \n# Flujo de eventos alternativo\n\n* Si el sistema ya tiene almacenado a ese ususario con ese nombre y contraseña, el sistema no guarda nada. Se muestar un mensaje de error."},{"_type":"UMLUseCase","_id":"AAAAAAGclVu2447QrMo=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Aceptar Oferta","ownedElements":[{"_type":"UMLExtend","_id":"AAAAAAGcntIpnvzwrc4=","_parent":{"$ref":"AAAAAAGclVu2447QrMo="},"source":{"$ref":"AAAAAAGclVu2447QrMo="},"target":{"$ref":"AAAAAAGclVvXGY9SyJg="}}],"documentation":"# Flujo de eventos: Aceptar Oferta\n\n1. El comprador inserta la clave de una Oferta y el precio que está dispuesto a apagr.\n2. El sistema guarda la propuesta.\n\n\n# Flujo de eventos alternativo\n\n* No se introduce un valor monetario válido. No se guarda la propuesta de oferta. \n\n* El saldo del comprador es negativo o igual a 0. No se guarda la propuesta de oferta.\n"},{"_type":"UMLUseCase","_id":"AAAAAAGclVvXGY9SyJg=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Ver Oferta","ownedElements":[{"_type":"UMLExtend","_id":"AAAAAAGcnsRs/MTFU/c=","_parent":{"$ref":"AAAAAAGclVvXGY9SyJg="},"source":{"$ref":"AAAAAAGclVvXGY9SyJg="},"target":{"$ref":"AAAAAAGclVv0io/URwQ="}}],"documentation":"# Flujo de eventos: Ver Oferta\n1. El usuariro inserta una clave de una Oferta.\n2. El sistema muestra toda la información asociada con la clave (título, descripción, estado, precio, fecha de publicación y archeivo(foto)).\n3. Si el usuario quiere ofrecer algún precio por la oferta, extends Aceptar Oferta.\n\n#Flujo alternativo\n* Si algún atributo no tiene ningún valor, se mostrará vacío."},{"_type":"UMLUseCase","_id":"AAAAAAGclVv0io/URwQ=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Consultar Ofertas","documentation":"# Flujo de eventos: Consultar ofertas\n\n1. El ususario inserta un texto.\n2. El sistema muestra las ofertas activas (título, descripción, fecha de publicación) que contengan el texto insertado en el título.\n3. Si el ususario es comprador y quiere ver los detalles de la oferta extends Ver Oferta.\n\n# Flujo de eventos alternativo\n\n* No existen ofertas activas con el texto en su título. Se muestra un menaje que describa la situación.\n"},{"_type":"UMLUseCase","_id":"AAAAAAGclVxL0ZDllLk=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Ver ofertas Aceptadas","ownedElements":[{"_type":"UMLAssociation","_id":"AAAAAAGclV0JwJl/NM0=","_parent":{"$ref":"AAAAAAGclVxL0ZDllLk="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclV0JwJmAMyE=","_parent":{"$ref":"AAAAAAGclV0JwJl/NM0="},"reference":{"$ref":"AAAAAAGclVxL0ZDllLk="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclV0JwJmBdkk=","_parent":{"$ref":"AAAAAAGclV0JwJl/NM0="},"reference":{"$ref":"AAAAAAGclVnrE4SvL1A="}}}],"documentation":"#Flujo de eventos: Ver Ofertas Aceotadas\n1. El vendedor inserta un texto.\n2. El sistema muestra las Sales asociadas al vendedor (títuo y precios ofrecidos) que contengan el texto en el título.\n"},{"_type":"UMLUseCase","_id":"AAAAAAGclVyJzpFnzVY=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Crear oferta","ownedElements":[{"_type":"UMLAssociation","_id":"AAAAAAGclVzblJUKZFo=","_parent":{"$ref":"AAAAAAGclVyJzpFnzVY="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclVzblJULCW8=","_parent":{"$ref":"AAAAAAGclVzblJUKZFo="},"reference":{"$ref":"AAAAAAGclVyJzpFnzVY="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGclVzblJUMnlQ=","_parent":{"$ref":"AAAAAAGclVzblJUKZFo="},"reference":{"$ref":"AAAAAAGclVnrE4SvL1A="}}}],"documentation":"# Flujo de eventos: Crear Oferta\n1. Vendedor inserta título, descripción, estado y precio.\n2. Vendedor selecciona una fecha de publicación.\n3. Vendedor selecciona un File.\n4. El sistema crea una Sale con la indormación insertada y asigna la Sale al Seller.\n\n# Flujo alternativo\n1. Algún campo está vacío. El sistema informa al vendedor.\n2. EL precio no es un número válido. El sistema informa al vendedor.\n3. La fecha de publicación es anterior a la fecha actual. El sistema informa al vendedor.\n4. La oferta Sale ya existe para este vendedor (mismo título). El sistema informa al vendedor.\n"},{"_type":"UMLUseCase","_id":"AAAAAAGdTqoqMbIj1DU=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Aceptar propuesta","documentation":"# Flujo de eventos: Aceptar Propuesta\n1. El vendedor inserta la clave de una ProposedSale propuesta.\n2. El sistema procede a retirar del saldo del Comprador que ha hecho la propuesta la cantidadOferecida.\n3. El sistema guarda la Oferta como acabada.\n4. El sistema guarda en la ProposedSale la fecha de la compra.\n5. El sistema ingresa el importe de la compra al Vendedor.\n\n#Flujo alternativo\n* Si la Sale asociada a la ProposedSale tiene estado \"Saled\", el sistema no hará nada.\n\n* Si el comprador tiene saldo menor o igual que 0, el sistema solo mostrará un mensaje de error en pantalla."},{"_type":"UMLUseCase","_id":"AAAAAAGdTqqXmLo2igE=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Ingresar Fondos","documentation":"# Flujo de eventos: Ingresar Fondos\n\n1. El comprador inserta la cantidad de fondos a ingresar.\n2. El sistema crea una Transacción de tipo ingreso con la cantidad insertada."},{"_type":"UMLUseCase","_id":"AAAAAAGdTqrn0cSnO2w=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Valorar compra","ownedElements":[{"_type":"UMLExtend","_id":"AAAAAAGdaNalAfWugJw=","_parent":{"$ref":"AAAAAAGdTqrn0cSnO2w="},"source":{"$ref":"AAAAAAGdTqrn0cSnO2w="},"target":{"$ref":"AAAAAAGdaNJKbqPXMNw="}}],"documentation":"# Flujo de eventos: Valorar Compra\n\n1. Comrpador inserta la clave de una ProposedSale que haya sido aceptada.\n2. Comprador inserta un número entre el 1 y 10 (valoración) y un breve texto explicando la razón de la valoración.\n3. El sistema guarda la valoracion.\n4. El sistema actualiza la valoración total del vendedor.\n\n#Flujo de eventos alternativo\n* La valoración insertada no está entre 1 y 10. Mostrar un mensaje explicando al situación."},{"_type":"UMLUseCase","_id":"AAAAAAGdaNJKbqPXMNw=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Ver Compras","ownedElements":[{"_type":"UMLAssociation","_id":"AAAAAAGdaNLEksBJLlI=","_parent":{"$ref":"AAAAAAGdaNJKbqPXMNw="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGdaNLEksBK2hM=","_parent":{"$ref":"AAAAAAGdaNLEksBJLlI="},"reference":{"$ref":"AAAAAAGdaNJKbqPXMNw="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGdaNLEksBL4Gw=","_parent":{"$ref":"AAAAAAGdaNLEksBJLlI="},"reference":{"$ref":"AAAAAAGclVoJ/oTZAl4="}}}],"documentation":"# Flujo de Eventos: Ver Compras\n1. El comprador inserta un texto.\n2. El sistema muestra las ofertas adquiridas por el comprador (título, precio pagado, fecha de compra) que contengan el texto insertado en el título.\n3. Si el comprador quiere hacer una valoración sobre la compra extends Valorar Compra.\n\n# Flujo de eventos alternativo\n\n* No existen compras realizadas por el comprador con el texto en su título. Se muestra un menaje que describa la situación.\n"},{"_type":"UMLUseCase","_id":"AAAAAAGdgm+nxvkOvdA=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Retirar Fondos","ownedElements":[{"_type":"UMLAssociation","_id":"AAAAAAGdgnCrO1U+920=","_parent":{"$ref":"AAAAAAGdgm+nxvkOvdA="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGdgnCrO1U/Tc8=","_parent":{"$ref":"AAAAAAGdgnCrO1U+920="},"reference":{"$ref":"AAAAAAGdgm+nxvkOvdA="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGdgnCrO1VAmes=","_parent":{"$ref":"AAAAAAGdgnCrO1U+920="},"reference":{"$ref":"AAAAAAGclVoJ/oTZAl4="}}}],"documentation":"# Flujo de eventos: Ingresar Fondos\n\n1. El comprador inserta la cantidad de fondos a retirar.\n2. El sistema crea una Transacción de tipo extracción con la cantidad insertada.\n\n# Flujo alternativo\n* El comprador no tiene saldo suficiente para retirar. El sistema no hace nada.\n\n"},{"_type":"UMLUseCase","_id":"AAAAAAGdgnDqvYFfwig=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Ver Historial de Transacciones","documentation":"# Flujo de eventos: Ingresar Fondos\n\n1. El sistema muestra todas las transaciones que ha realizado el comprador."},{"_type":"UMLUseCase","_id":"AAAAAAGd3qOsh3boOYQ=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Ver Ventas","documentation":"# Flujo de Eventos: Ver ventas\n\n1. El sistema muestra la puntuación global del vendedor.\n2. El vendedor inserta un texto.\n3. El sistema muestra las ofertas vendidas por el vendedor (título, precio pagado, comprador, valoración) que contengan el texto insertado en el título.\n4. Si el vendedor quiere ver la valoracion, extends Ver Valoracion.\n\n# Flujo de eventos alternativo\n\n* No existen ventas realizadas por el vendedor con el texto en su título. Se muestra un menaje que describa la situación."},{"_type":"UMLUseCase","_id":"AAAAAAGd3qREFHwgGb8=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Ver valoracion","ownedElements":[{"_type":"UMLExtend","_id":"AAAAAAGeCP6TVwpjWIc=","_parent":{"$ref":"AAAAAAGd3qREFHwgGb8="},"source":{"$ref":"AAAAAAGd3qREFHwgGb8="},"target":{"$ref":"AAAAAAGd3qOsh3boOYQ="}}],"documentation":"# Flujo de eventos: Ver valoracion\n\n1. El vendedor inserta la clave de una valoracion.\n2. El sistema muestra la valoracion, y su comentario."},{"_type":"UMLUseCase","_id":"AAAAAAGd3qVJsYP2auQ=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Iniciar conversacion","ownedElements":[{"_type":"UMLDependency","_id":"AAAAAAGd/FmtNEXuKLs=","_parent":{"$ref":"AAAAAAGd3qVJsYP2auQ="},"name":"extend","source":{"$ref":"AAAAAAGd3qVJsYP2auQ="},"target":{"$ref":"AAAAAAGclVvXGY9SyJg="}}],"documentation":"# Flujo de eventos: Iniciar conversacion\n\n1. El comprador inserta la clave de una oferta y el tema de la conversacion.\n2. El sistema crea una conversación con el tema.\n2. includes Enviar mensaje.\n3. El sistema guarda la conversación con el tema.\n\n\n# Flujo de alternativo: Iniciar conversacion\n\n* Si el comprador no inserta un tema, se le indica que es necesario y no se crea la conversacion.\n* El comprador no envía ningún mensaje: no se crea la conversación."},{"_type":"UMLUseCase","_id":"AAAAAAGd3qWCoYheBFY=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Consultar conversaciones","documentation":"# Flujo de eventos: Consultar conversaciones\n\n1. El sistema muestra todas las conversaciones.\n2. Si el comprador quiere ver el contenido de una conversacion: extends Ver Conversacion."},{"_type":"UMLUseCase","_id":"AAAAAAGd3rgAfY9+vco=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Enviar Mensaje","ownedElements":[{"_type":"UMLAssociation","_id":"AAAAAAGd3rhC3JLe6NY=","_parent":{"$ref":"AAAAAAGd3rgAfY9+vco="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGd3rhC3JLfhLA=","_parent":{"$ref":"AAAAAAGd3rhC3JLe6NY="},"reference":{"$ref":"AAAAAAGd3rgAfY9+vco="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGd3rhC3JLgMU8=","_parent":{"$ref":"AAAAAAGd3rhC3JLe6NY="},"reference":{"$ref":"AAAAAAGclVoJ/oTZAl4="}}},{"_type":"UMLInclude","_id":"AAAAAAGd3rneg5zJ1zc=","_parent":{"$ref":"AAAAAAGd3rgAfY9+vco="},"source":{"$ref":"AAAAAAGd3rgAfY9+vco="},"target":{"$ref":"AAAAAAGd3qVJsYP2auQ="}},{"_type":"UMLExtend","_id":"AAAAAAGd/Fn8s1zwSOA=","_parent":{"$ref":"AAAAAAGd3rgAfY9+vco="},"source":{"$ref":"AAAAAAGd3rgAfY9+vco="},"target":{"$ref":"AAAAAAGd3sSX4a5qM50="}}],"documentation":"# Flujo de eventos: Enviar Mensaje\n\n1. El usuario inserta la clave de una conversacion y el mensaje que quiere enviar. Pulsa enviar.\n2. El sistema añade a la conversacion un nuevo mensaje, con el texto y el momento que se envio.\n3. El sistema actualiza el estado de la conversación."},{"_type":"UMLUseCase","_id":"AAAAAAGd3sSX4a5qM50=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Ver conversacion","ownedElements":[{"_type":"UMLExtend","_id":"AAAAAAGd/PpOQxukd1c=","_parent":{"$ref":"AAAAAAGd3sSX4a5qM50="},"source":{"$ref":"AAAAAAGd3sSX4a5qM50="},"target":{"$ref":"AAAAAAGd3qWCoYheBFY="}},{"_type":"UMLExtend","_id":"AAAAAAGeCOX3ElQdH6Q=","_parent":{"$ref":"AAAAAAGd3sSX4a5qM50="},"source":{"$ref":"AAAAAAGd3sSX4a5qM50="},"target":{"$ref":"AAAAAAGeCOV7GRzOfvU="}}],"documentation":"# Flujo de eventos: Ver conversacion\n\n1. El usuario elige la conversacion.\n2. El sistema muestra por cada mensaje de la conversacion cuando se ha enviado y su contenido.\n3. El usuario quiere enviar otro mensaje, extends Enviar Mensaje."},{"_type":"UMLUseCase","_id":"AAAAAAGeCOV7GRzOfvU=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Consultar Conversaciones","documentation":"# Flujo de eventos: Consultar conversaciones\n\n1. El sistema muestra todas las conversaciones (Sale asociada, tema y esatdo)\n2. Si el comprador quiere ver el contenido de una conversacion: extends Ver Conversacion."}]}]},{"_type":"UMLModel","_id":"AAAAAAGdYoyNS18bPdE=","_parent":{"$ref":"AAAAAAFF+h6SjaM2Hec="},"name":"Design","ownedElements":[{"_type":"UMLModel","_id":"AAAAAAGdYo0j0WNmqrQ=","_parent":{"$ref":"AAAAAAGdYoyNS18bPdE="},"name":"Casos De Uso","ownedElements":[{"_type":"UMLCollaboration","_id":"AAAAAAGdYo4f4WwuCqo=","_parent":{"$ref":"AAAAAAGdYo0j0WNmqrQ="},"name":"AceptarOferta","ownedElements":[{"_type":"UMLInteraction","_id":"AAAAAAGdYo4f4Wwvxf4=","_parent":{"$ref":"AAAAAAGdYo4f4WwuCqo="},"name":"Aceptar Oferta","ownedElements":[{"_type":"UMLSequenceDiagram","_id":"AAAAAAGdYo4f4Wwwbnk=","_parent":{"$ref":"AAAAAAGdYo4f4Wwvxf4="},"name":"Aceptar Oferta","ownedViews":[{"_type":"UMLFrameView","_id":"AAAAAAGdYo4f4Wwx31U=","_parent":{"$ref":"AAAAAAGdYo4f4Wwwbnk="},"model":{"$ref":"AAAAAAGdYo4f4Wwwbnk="},"subViews":[{"_type":"LabelView","_id":"AAAAAAGdYo4f4mwyOmw=","_parent":{"$ref":"AAAAAAGdYo4f4Wwx31U="},"font":"Arial;13;0","left":56.72998046875,"top":21,"width":84.5380859375,"height":13